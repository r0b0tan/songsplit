# Zugangsdaten fuer deploy.sh. Kopie davon als .env.deploy ablegen,
# Passwoerter eintragen, und: chmod 600 .env.deploy
# .env.deploy steht in .gitignore und darf dort auch bleiben.

DEPLOY_HOST=23.88.114.73
DEPLOY_USER=christoph
DEPLOY_PORT=22

# Login. Sobald ein Schluessel hinterlegt ist (./deploy.sh setup-key),
# DEPLOY_SSH_KEY setzen und DEPLOY_SSH_PASS leeren — dann liegt kein
# Passwort mehr auf der Platte.
DEPLOY_SSH_PASS=HIER_EINTRAGEN
DEPLOY_SSH_KEY=

# Nur fuer ./deploy.sh --reload-nginx. Fuer den Upload selbst wird kein sudo
# gebraucht: /var/www/mixapart.de/public gehoert christoph:www-data (755).
DEPLOY_SUDO_PASS=HIER_EINTRAGEN

# nginx-root laut Config. Der Inhalt von dist/ landet direkt darin,
# nicht der Ordner selbst.
DEPLOY_TARGET=/var/www/mixapart.de/public/

# Was gebaut und was hochgeladen wird.
DEPLOY_BUILD_CMD="npm run build:public"
DEPLOY_DIST=frontend/dist/mixapart-public/browser
DEPLOY_URL=https://mixapart.de/

# Optional: Cloudflare-Cache nach dem Deploy leeren. Token braucht die
# Berechtigung "Zone / Cache Purge". Leer lassen = Schritt entfaellt.
CF_API_TOKEN=
CF_ZONE_ID=
